# ----------------------------------------- signing material — never commit these
# project book §13.1: the keystore must be backed up offline, and the passwords must
# never appear in the repository, in the APK or in any document.
keystore.properties
*.jks
*.keystore

# ------------------------------------------------------ local diagnostic output
# logcat dumps collected while reproducing a device issue (BUILD-NOTES.md §10)
markview-log.txt
*.log

# ------------------------------------------------------- local project material
# Reviewer material kept at the repository root only: device screenshots, test reports and
# the review fixture. Anchored ("/test/") so the rule can never swallow the unit test
# sources under app/src/test/; the offline suite has its own fixture copy under
# tools/js-smoke/fixtures/.
/test/
/chat-export-*.md

# Files received through the WeChat bridge (documents, logs) stay on this machine.
/.pi-wechat-files/

# Generated by tools/icon-preview.py (run it to reproduce the preview).
tools/icon-preview.png

# Python bytecode from running the tools (tools/icon-preview.py)
__pycache__/
*.pyc
