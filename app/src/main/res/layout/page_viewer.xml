<?xml version="1.0" encoding="utf-8"?>
<!--
  Viewer page (project book §8): rendered Markdown only. No toolbar, no title bar,
  no floating action button and no persistent menu — the WebView fills the page.
  The single overlay below only reports a document that could not be read.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame"><!-- included as a page of activity_main, so it keeps its own root -->

    <!-- The WebView itself is created by ViewerController so it can be rebuilt if
         the renderer process ever dies. -->
    <FrameLayout
        android:id="@+id/viewer_webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/viewer_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/folder_row_background"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/viewer_error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/viewer_error_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/viewer_error_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
